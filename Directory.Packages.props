<Project>

	<!-- Central Package Management: all package versions live here, in one place. JorgeCostaMacia.Bus (bus-dotnet)
	     and JorgeCostaMacia.DDD.DomainEvent (ddd-dotnet) are published packages like any third-party one, so a
	     transport takes a new core by bumping its version here. Inter-package JorgeCostaMacia.Bus.RabbitMQ.* deps (same
	     repo) are ProjectReferences (lockstep versioning), so CPM doesn't manage them. -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="JorgeCostaMacia.Bus" Version="4.5.0" />
		<PackageVersion Include="JorgeCostaMacia.DDD.DomainEvent" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
		<PackageVersion Include="Npgsql" Version="10.0.3" />
		<PackageVersion Include="Quartz" Version="4.6.2" />
		<PackageVersion Include="Quartz.Extensions.DependencyInjection" Version="4.6.2" />
		<PackageVersion Include="Quartz.Extensions.Hosting" Version="4.6.2" />
		<PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="4.6.2" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Testcontainers" Version="4.16.0" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
		<PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

</Project>
